# PayFlow Backend Environment Configuration Example
# Copy this file to .env and provide your actual credentials

# PostgreSQL Database (e.g. Neon PostgreSQL: postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require)
DATABASE_URL=postgresql://localhost:5432/payflow
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Redis Cache (e.g. Upstash Redis: rediss://default:password@xyz.upstash.io:6379 or local: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# JWT Secret (minimum 64 characters / 512 bits for HMAC-SHA512)
JWT_SECRET=cGF5Zmxvdy1kZW1vLWp3dC1zZWNyZXQta2V5LXNob3VsZC1iZS12ZXJ5LWxvbmctYW5kLXNlY3VyZS0xMjM0NTY3ODkw

# External APIs (free tier accounts or mock placeholders)
RESEND_API_KEY=re_placeholder_key
GROQ_API_KEY=gsk_placeholder_key
